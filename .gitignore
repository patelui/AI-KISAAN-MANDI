# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Build output
client/dist/
client/dist-ssr/
build/
out/

# Environment variables and secrets
# Never commit real secrets — use .env.example files instead
.env
.env.*
!.env.example
!**/.env.example
server/.env
client/.env
*.pem
*.key
credentials.json
secrets.json

# Logs and debug output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test and coverage artifacts
coverage/
.nyc_output/

# Caches
.cache/
.parcel-cache/
.eslintcache
*.tsbuildinfo
client/node_modules/.vite/

# Editor and IDE files
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Optional local tooling
*.local

# Uploaded user files (profile photos, etc.)
server/uploads/
